{
  "name": "quality-backend",
  "dockerComposeFile": ["../docker/dev/compose.yaml", "compose.yaml"],
  "service": "express",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerUser": "node",
  "remoteUser": "node",
  "overrideCommand": false,
  "forwardPorts": [5000],
  "postCreateCommand": "npm install && npx prisma generate && npx prisma migrate deploy && npx prisma db seed",
  "postStartCommand": "npm install && npx prisma generate && npx prisma migrate deploy && npm run dev",
  "customizations": {
      "extensions": [
        "esbenp.prettier-vscode",
        "christian-kohler.path-intellisense",
        "PKief.material-icon-theme",
        "oxc.oxc-vscode",
        "EditorConfig.EditorConfig",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-containers",
        "Prisma.prisma",
        "bruno-api-client.bruno",
        "anysphere.remote-containers"
        //"ms-vscode-remote.remote-containers"
      ]
  }
}