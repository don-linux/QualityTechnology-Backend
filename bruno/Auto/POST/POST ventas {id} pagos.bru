meta {
  name: POST ventas {id} pagos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ventas/{{id}}/pagos
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "monto": 1000,
    "cuenta_nombre": "Caja",
    "fecha": "2026-06-26",
    "observaciones": "Pago QA"
  }
}
