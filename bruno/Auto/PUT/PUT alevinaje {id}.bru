meta {
  name: PUT alevinaje {id}
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/alevinaje/{{id}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "infraestructura_fisica_id": 1,
    "cantidad_total": 1000,
    "lote": "LOTE-QA-01"
  }
}
