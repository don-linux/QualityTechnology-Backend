meta {
  name: PUT cuentas {id}
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/cuentas/{{id}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fc_udn": "CQT",
    "fc_nombre": "Cuenta principal CQT",
    "fc_numero_cuenta": "0000-1234-5678",
    "fc_tipo": "Cheques"
  }
}
