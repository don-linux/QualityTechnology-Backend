meta {
  name: 06 POST Proveedor
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/proveedores
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "nombre": "{{runTag}} Proveedor",
