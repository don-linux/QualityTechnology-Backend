    "categoria": "INSUMOS",
    "contacto": "Contacto {{runTag}}",
    "telefono": "5552003000",
    "correo": "{{runTag}}_proveedor@test.local",
    "direccion": "Calle 1",
    "forma_pago": "TRANSFERENCIA",
    "plazo_credito": "15",
    "monto_promedio": 1000,
    "activo": true
  }
}
