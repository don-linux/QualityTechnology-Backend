meta {
  name: 08 PUT Proveedor
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/proveedores/{{proveedorId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "nombre": "{{runTag}} Proveedor UPD",
    "empresa": "{{runTag}} S.A. de C.V.",
    "rfc": "XAXX010101000",
    "categoria": "INSUMOS",
    "contacto": "Contacto {{runTag}} UPD",
    "telefono": "5552003999",
    "correo": "{{runTag}}_proveedor_upd@test.local",
    "direccion": "Calle 2",
    "forma_pago": "TRANSFERENCIA",
    "plazo_credito": "30",
    "monto_promedio": 2500,
    "activo": true
  }
}
