meta {
  name: 04 PUT Cliente
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/clientes/{{clienteId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fc_nombre": "{{runTag}} Cliente UPD",
    "fc_telefono": "5551002999",
    "fc_correo": "{{runTag}}_cliente_upd@test.local",
    "fc_localidad": "Merida",
    "fc_cp": "97100",
    "fi_usuario_id": {{fiUsuarioId}}
  }
}
