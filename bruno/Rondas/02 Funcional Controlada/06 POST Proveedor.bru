    "nombre_contacto": "Contacto {{runTag}}",
    "telefono": "5552003000",
    "correo": "{{runTag}}_proveedor@test.local",
    "localidad": "Localidad {{runTag}}",
    "estado": "CDMX",
    "ejecutivo": "Ejecutivo {{runTag}}",
    "precio_venta": 1000
  }
}
