meta {
  name: 08 PUT Proveedor
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/proveedores/{{proveedorId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "razon_social": "{{runTag}} Proveedor UPD",
    "rfc": "XAXX010101000",
    "udn": "{{runTag}} UdN UPD",
    "nombre_contacto": "Contacto {{runTag}} UPD",
    "telefono": "5552003999",
    "correo": "{{runTag}}_proveedor_upd@test.local",
    "localidad": "Localidad {{runTag}} UPD",
    "estado": "Jalisco",
    "ejecutivo": "Ejecutivo {{runTag}} UPD",
    "precio_venta": 2500
  }
}
