meta {
  name: 08 PUT Proveedor
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/proveedores/{{proveedorId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fc_razon_social": "{{runTag}} Proveedor UPD",
    "fc_rfc": "XAXX010101000",
    "fc_producto_servicio": "Insumos {{runTag}} UPD",
    "fi_unidad_negocio_id": 1,
    "fc_nombre_contacto": "Contacto {{runTag}} UPD",
    "fc_telefono": "5552003999",
    "fc_correo": "{{runTag}}_proveedor_upd@test.local",
    "fc_localidad": "Localidad {{runTag}} UPD",
    "fc_estado": "Jalisco"
  }
}
