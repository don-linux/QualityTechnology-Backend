meta {
  name: 07B POST FlujoCaja Multipart (opcional)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/flujo-caja
  body: multipartForm
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  fc_granja: {{granja}}
  fd_fecha: 2026-03-06
  fn_ingreso: 250.75
  fn_egreso: 0
  fc_observaciones: {{runTag}} Flujo Caja Multipart
  fc_cuenta: {{cuentaNombre}}
  fc_categoria: INGRESO
  fc_subcategoria: VALIDACION
  fc_beneficiario: QA
  fc_noproyecto: {{runTag}}-FC-MP
  fc_estatus: REPOSICION
  facturaFile: @/tmp/factura-demo.txt
}

notes {
  Opcional: crea el archivo antes de ejecutar.
  Ejemplo Linux:
  echo "factura demo" > /tmp/factura-demo.txt
}
