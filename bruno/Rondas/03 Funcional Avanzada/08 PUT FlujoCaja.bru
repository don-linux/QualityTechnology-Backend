meta {
  name: 08 PUT FlujoCaja
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/flujo-caja/{{movimientoId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fc_granja": "{{granja}}",
    "fd_fecha": "2026-03-06",
    "fn_ingreso": 0,
    "fn_egreso": 50,
    "fc_descripcion": "{{runTag}} Flujo Caja UPD",
    "fc_cuenta": "{{cuentaNombre}}",
    "fc_categoria": "EGRESO",
    "fc_subcategoria": "VALIDACION_UPD",
    "fc_beneficiario": "QA_UPD",
    "fc_noproyecto": "{{runTag}}-FC-UPD",
    "fc_factura": null,
    "fc_estatus": "PARCIAL"
  }
}
