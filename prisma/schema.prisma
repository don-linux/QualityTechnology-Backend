generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalogos", "public", "rrhh", "seguridad"]
}

model Rol {
  id           Int         @id @default(autoincrement())
  nombre       String      @unique @db.VarChar(50)
  esRoot       Boolean     @default(false) @map("es_root")
  created_at   DateTime    @default(now()) @db.Timestamp(6)
  updated_at   DateTime    @updatedAt @db.Timestamp(6)
  rolesModulos RolModulo[]
  usuarios     Usuario[]

  @@map("roles")
  @@schema("public")
}

model Usuario {
  id                 Int                @id @default(autoincrement())
  nombre             String             @unique @db.VarChar(100)
  password           String             @db.VarChar(255)
  rolId              Int                @map("rol_id")
  esta_activo        Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  updated_at         DateTime           @db.Timestamp(6)
  alevinaje          alevinaje[]
  alimentacion       Alimentacion[]
  alimentos          Alimento[]
  banos              Bano[]
  biometrias         Biometria[]
  empleados          Empleado?
  engorda            Engorda[]
  equipos            Equipo[]
  flujo_caja         FlujoCaja[]
  insumos            Insumo[]
  inventarioAlevines InventarioAlevin[]
  medicamentos       Medicamento[]
  observacion        observacion[]
  parametros         Parametro[]
  plagas             Plaga[]
  recambios          Recambio[]
  recepcionInsumos   RecepcionInsumo[]
  refreshTokens      RefreshToken[]
  reproductores      Reproductor[]
  siembra            siembra[]
  rol                Rol                @relation(fields: [rolId], references: [id])
  ventas             Venta[]
  visitas            Visita[]

  @@index([rolId])
  @@map("usuarios")
  @@schema("public")
}

model Modulo {
  id           Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(80)
  ruta         String      @unique @db.VarChar(120)
  esta_activo  Boolean     @default(true)
  rolesModulos RolModulo[]

  @@map("modulos")
  @@schema("public")
}

model RolModulo {
  rolId    Int    @map("rol_id")
  moduloId Int    @map("modulo_id")
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  rol      Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, moduloId])
  @@map("roles_modulos")
  @@schema("public")
}

model RefreshToken {
  id               Int      @id @default(autoincrement())
  usuarioId        Int      @map("usuario_id")
  token            String   @unique @db.VarChar(255)
  fecha_expiracion DateTime @db.Timestamp(6)
  es_revocado      Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
  @@schema("public")
}

model Puesto {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  esta_activo Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  empleados   Empleado[]

  @@map("puestos")
  @@schema("public")
}

model Departamento {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  esta_activo Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  empleados   Empleado[]

  @@map("departamentos")
  @@schema("public")
}

model TipoDocumento {
  id          Int                 @id @default(autoincrement())
  nombre      String              @unique @db.VarChar(100)
  esta_activo Boolean             @default(true)
  created_at  DateTime            @default(now()) @db.Timestamp(6)
  updated_at  DateTime            @db.Timestamp(6)
  documentos  DocumentoEmpleado[]

  @@map("tipos_documento")
  @@schema("public")
}

model UnidadNegocio {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100)
  esta_activo Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@map("unidades_negocio")
  @@schema("public")
}

model Instalacion {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  tipo          String?  @db.VarChar(80)
  granja        String   @db.VarChar(120)
  capacidad     Decimal? @db.Decimal(12, 2)
  observaciones String?  @db.VarChar(300)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @db.Timestamp(6)
  lotes         Lote[]

  @@index([tipo])
  @@index([granja])
  @@map("instalaciones")
  @@schema("public")
}

model Reproductor {
  id             Int          @id @default(autoincrement())
  pileta_id      Int          @unique
  machos         Int          @default(0)
  hembras        Int          @default(0)
  cantidad_total Int
  talla          Decimal?     @db.Decimal(10, 2)
  ratio          String?      @db.VarChar(20)
  linea          String?      @db.VarChar(60)
  familia        String?      @db.VarChar(60)
  observacionId  Int?         @map("observacion_id")
  siembra_id     Int?
  biometria_id   Int?
  usuarioId      Int          @map("usuario_id")
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  updated_at     DateTime     @db.Timestamp(6)
  alimentos      Alimento[]
  biometrias     Biometria?   @relation(fields: [biometria_id], references: [id])
  observacion    observacion? @relation(fields: [observacionId], references: [id])
  piletas        Pileta       @relation(fields: [pileta_id], references: [id])
  siembra        siembra?     @relation(fields: [siembra_id], references: [id])
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([familia])
  @@index([linea])
  @@map("reproductores")
  @@schema("public")
}

model Lote {
  id            Int         @id @default(autoincrement())
  nombre        String      @db.VarChar(100)
  instalacionId Int         @map("instalacion_id")
  familia       String?     @db.VarChar(60)
  fecha_ingreso DateTime?   @db.Date
  cantidad      Int?
  estatus       String?     @db.VarChar(30)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @db.Timestamp(6)
  instalacion   Instalacion @relation(fields: [instalacionId], references: [id])

  @@index([instalacionId])
  @@map("lotes")
  @@schema("public")
}

model Pileta {
  id                                      Int                @id @default(autoincrement())
  nombre                                  String             @db.VarChar(100)
  largo                                   Decimal            @db.Decimal(10, 2)
  ancho                                   Decimal            @db.Decimal(10, 2)
  alto                                    Decimal            @db.Decimal(10, 2)
  metros_cubicos                          Decimal            @db.Decimal(14, 3)
  material                                String             @db.VarChar(80)
  estado                                  PiletaEstado       @default(vacia)
  tipo                                    PiletaTipo
  ubicacionId                             Int                @map("ubicacion_id")
  created_at                              DateTime           @default(now()) @db.Timestamp(6)
  updated_at                              DateTime           @db.Timestamp(6)
  alevinaje                               alevinaje[]
  alimentacion                            Alimentacion[]
  alimentos                               Alimento[]
  biometrias                              Biometria[]
  engorda                                 Engorda?
  inventario_alevines                     InventarioAlevin[]
  ubicacion                               ubicacion          @relation(fields: [ubicacionId], references: [id])
  recambios                               Recambio[]
  reproductores                           Reproductor?
  siembra_siembra_pileta_destinoTopiletas siembra[]          @relation("siembra_pileta_destinoTopiletas")
  siembra_siembra_pileta_origenTopiletas  siembra[]          @relation("siembra_pileta_origenTopiletas")

  @@unique([nombre, ubicacionId])
  @@index([estado])
  @@index([tipo])
  @@index([ubicacionId])
  @@map("piletas")
  @@schema("public")
}

model Engorda {
  id            Int          @id @default(autoincrement())
  pileta_id     Int          @unique
  cantidad      Int
  tallaGr       Decimal?     @map("talla_gr") @db.Decimal(10, 2)
  observacionId Int?         @map("observacion_id")
  siembra_id    Int?
  biometria_id  Int?
  usuarioId     Int          @map("usuario_id")
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @db.Timestamp(6)
  alimentos     Alimento[]
  biometrias    Biometria?   @relation(fields: [biometria_id], references: [id])
  observacion   observacion? @relation(fields: [observacionId], references: [id])
  piletas       Pileta       @relation(fields: [pileta_id], references: [id])
  siembra       siembra?     @relation(fields: [siembra_id], references: [id])
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])

  @@map("engorda")
  @@schema("public")
}

model Equipo {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  tipo           String?         @db.VarChar(80)
  marca          String?         @db.VarChar(80)
  modelo         String?         @db.VarChar(80)
  serial         String?         @db.VarChar(80)
  usuarioId      Int?            @map("usuario_id")
  estado         String?         @db.VarChar(30)
  observaciones  String?         @db.VarChar(300)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  updated_at     DateTime        @db.Timestamp(6)
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id])
  mantenimientos Mantenimiento[]

  @@index([usuarioId])
  @@map("equipos")
  @@schema("public")
}

model Mantenimiento {
  id          Int      @id @default(autoincrement())
  equipoId    Int      @map("equipo_id")
  descripcion String   @db.VarChar(500)
  fecha       DateTime @db.Date
  costo       Decimal? @db.Decimal(12, 2)
  responsable String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @db.Timestamp(6)
  equipo      Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@index([fecha(sort: Desc)])
  @@index([equipoId])
  @@map("mantenimientos")
  @@schema("public")
}

model Alimento {
  id                   Int          @id @default(autoincrement())
  piletaId             Int?         @map("pileta_id")
  engordaId            Int?         @map("engorda_id")
  reproductorId        Int?         @map("reproductor_id")
  milimetros_particula Decimal?     @db.Decimal(10, 2)
  cantidad_dia         Decimal?     @db.Decimal(10, 3)
  porcion              Decimal?     @db.Decimal(10, 3)
  costo_total          Decimal?     @db.Decimal(12, 2)
  usuarioId            Int          @map("usuario_id")
  created_at           DateTime     @default(now()) @db.Timestamp(6)
  updated_at           DateTime     @db.Timestamp(6)
  engorda              Engorda?     @relation(fields: [engordaId], references: [id], onDelete: Restrict)
  pileta               Pileta?      @relation(fields: [piletaId], references: [id], onDelete: Restrict)
  reproductor          Reproductor? @relation(fields: [reproductorId], references: [id], onDelete: Restrict)
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([engordaId])
  @@index([piletaId])
  @@index([reproductorId])
  @@index([usuarioId])
  @@map("alimentos")
  @@schema("public")
}

model Empleado {
  id              Int                  @id @default(autoincrement())
  nombre          String               @db.VarChar(100)
  apellidoPaterno String               @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno String?              @map("apellido_materno") @db.VarChar(100)
  usuarioId       Int?                 @unique @map("usuario_id")
  puestoId        Int?                 @map("puesto_id")
  departamentoId  Int?                 @map("departamento_id")
  sueldo_base     Decimal?             @db.Decimal(12, 2)
  fecha_ingreso   DateTime?            @db.Date
  esta_activo     Boolean              @default(true)
  created_at      DateTime             @default(now()) @db.Timestamp(6)
  updated_at      DateTime             @db.Timestamp(6)
  actas           ActaAdministrativa[]
  documentos      DocumentoEmpleado[]
  departamento    Departamento?        @relation(fields: [departamentoId], references: [id])
  puesto          Puesto?              @relation(fields: [puestoId], references: [id])
  usuario         Usuario?             @relation(fields: [usuarioId], references: [id])
  nominas         Nomina[]
  vacaciones      Vacacion[]

  @@index([departamentoId])
  @@index([puestoId])
  @@index([usuarioId])
  @@map("empleados")
  @@schema("public")
}

model DocumentoEmpleado {
  id              Int            @id @default(autoincrement())
  empleadoId      Int            @map("empleado_id")
  tipoDocumentoId Int?           @map("tipo_documento_id")
  nombre_archivo  String         @db.VarChar(255)
  rutaArchivo     String         @map("ruta_archivo") @db.VarChar(500)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  empleado        Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipoDocumento   TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])

  @@index([empleadoId])
  @@map("documentos_empleado")
  @@schema("public")
}

model ActaAdministrativa {
  id             Int      @id @default(autoincrement())
  empleadoId     Int      @map("empleado_id")
  descripcion    String?  @db.VarChar(500)
  nombre_archivo String   @db.VarChar(255)
  rutaArchivo    String   @map("ruta_archivo") @db.VarChar(500)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  empleado       Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("actas_administrativas")
  @@schema("public")
}

model Nomina {
  id            Int      @id @default(autoincrement())
  empleadoId    Int      @map("empleado_id")
  periodo       String   @db.VarChar(20)
  sueldo_bruto  Decimal  @db.Decimal(12, 2)
  descuentos    Decimal  @default(0) @db.Decimal(12, 2)
  sueldo_neto   Decimal  @db.Decimal(12, 2)
  fechaPago     DateTime @map("fecha_pago") @db.Date
  observaciones String?  @db.VarChar(300)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @db.Timestamp(6)
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([periodo])
  @@map("nomina")
  @@schema("public")
}

model Vacacion {
  id            Int      @id @default(autoincrement())
  empleadoId    Int      @map("empleado_id")
  fecha_inicio  DateTime @db.Date
  fecha_fin     DateTime @db.Date
  dias_tomados  Int
  tipo          String   @default("ordinarias") @db.VarChar(50)
  estatus       String   @default("aprobadas") @db.VarChar(30)
  observaciones String?  @db.VarChar(300)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @db.Timestamp(6)
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([fecha_inicio(sort: Desc)])
  @@map("vacaciones")
  @@schema("public")
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(150)
  empresa      String?       @db.VarChar(150)
  telefono     String?       @db.VarChar(20)
  email        String?       @db.VarChar(100)
  esta_activo  Boolean       @default(true)
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  updated_at   DateTime      @db.Timestamp(6)
  lista_espera ListaEspera[]

  @@index([nombre])
  @@map("clientes")
  @@schema("public")
}

model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  rfc         String?  @db.VarChar(13)
  telefono    String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  direccion   String?  @db.VarChar(255)
  esta_activo Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamp(6)

  @@index([nombre])
  @@map("proveedores")
  @@schema("public")
}

model Venta {
  id              Int          @id @default(autoincrement())
  folio           String?      @db.VarChar(50)
  fecha           DateTime     @db.Date
  cliente_nombre  String       @db.VarChar(150)
  tipoVenta       String       @map("tipo_venta") @db.VarChar(50)
  cantidad        Int
  precio_unitario Decimal      @db.Decimal(10, 2)
  montoTotal      Decimal      @map("monto_total") @db.Decimal(12, 2)
  monto_abonado   Decimal      @default(0) @db.Decimal(12, 2)
  monto_adeudo    Decimal      @default(dbgenerated("(monto_total - monto_abonado)")) @db.Decimal(12, 2)
  estadoPago      String       @default("ADEUDO") @map("estado_pago") @db.VarChar(20)
  empresa         String       @db.VarChar(255)
  vendedor_nombre String?      @db.VarChar(255)
  observacionId   Int?         @map("observacion_id")
  usuario_id      Int
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  updated_at      DateTime     @db.Timestamp(6)
  observacion     observacion? @relation(fields: [observacionId], references: [id])
  usuarios        Usuario      @relation(fields: [usuario_id], references: [id])

  @@index([fecha(sort: Desc)])
  @@index([estadoPago])
  @@index([empresa])
  @@index([cliente_nombre])
  @@map("ventas")
  @@schema("public")
}

model ListaEspera {
  id              Int      @id @default(autoincrement())
  cliente_id      Int?
  cliente_nombre  String   @db.VarChar(150)
  cantidad_peces  Int?
  precio_unitario Decimal? @db.Decimal(10, 2)
  notas           String?  @db.VarChar(500)
  estatus         String   @default("PENDIENTE") @db.VarChar(30)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @db.Timestamp(6)
  clientes        Cliente? @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@index([estatus])
  @@map("lista_espera")
  @@schema("public")
}

model Cuenta {
  id             Int      @id @default(autoincrement())
  unidad_negocio String   @db.VarChar(100)
  nombre         String   @db.VarChar(100)
  numeroCuenta   String?  @map("numero_cuenta") @db.VarChar(50)
  banco          String?  @db.VarChar(150)
  tipo_cuenta    String   @db.VarChar(20)
  saldoActual    Decimal  @default(0) @map("saldo_actual") @db.Decimal(15, 2)
  esta_activa    Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @db.Timestamp(6)

  @@index([nombre])
  @@index([esta_activa])
  @@index([unidad_negocio])
  @@map("cuentas")
  @@schema("public")
}

model FlujoCaja {
  id            Int       @id @default(autoincrement())
  ubicacionId   Int       @map("ubicacion_id")
  fecha         DateTime  @db.Date
  ingreso       Decimal   @default(0) @db.Decimal(12, 2)
  egreso        Decimal   @default(0) @db.Decimal(12, 2)
  descripcion   String?   @db.VarChar(200)
  cuenta_nombre String?   @db.VarChar(50)
  categoria     String?   @db.VarChar(100)
  subcategoria  String?   @db.VarChar(100)
  beneficiario  String?   @db.VarChar(100)
  estatus       String?   @db.VarChar(20)
  mes_periodo   String?   @db.VarChar(7)
  usuario_id    Int?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @db.Timestamp(6)
  ubicacion     ubicacion @relation(fields: [ubicacionId], references: [id])
  usuarios      Usuario?  @relation(fields: [usuario_id], references: [id])

  @@index([fecha(sort: Desc)])
  @@index([categoria])
  @@index([estatus])
  @@index([cuenta_nombre])
  @@index([mes_periodo])
  @@index([ubicacionId])
  @@map("flujo_caja")
  @@schema("public")
}

model Alimentacion {
  id                  Int          @id @default(autoincrement())
  ubicacionId         Int          @map("ubicacion_id")
  fecha               DateTime?    @db.Date
  mes                 String?      @db.VarChar(20)
  pileta_id           Int?
  fechaSiembra        DateTime?    @map("fecha_siembra") @db.Date
  origenAlevines      String?      @map("origen_alevines") @db.VarChar(200)
  pesoPromedioEntrada Decimal?     @map("peso_promedio_entrada") @db.Decimal(12, 3)
  totalAlimentoKg     Decimal?     @map("total_alimento_kg") @db.Decimal(12, 3)
  mortalidad          Int?
  recambioAgua        String?      @map("recambio_agua") @db.VarChar(50)
  temperatura_agua    Decimal?     @db.Decimal(6, 2)
  amonio              Decimal?     @db.Decimal(10, 4)
  ph                  Decimal?     @db.Decimal(5, 2)
  observacionId       Int?         @map("observacion_id")
  usuarioId           Int          @map("usuario_id")
  created_at          DateTime     @default(now()) @db.Timestamp(6)
  updated_at          DateTime     @db.Timestamp(6)
  observacion         observacion? @relation(fields: [observacionId], references: [id])
  piletas             Pileta?      @relation(fields: [pileta_id], references: [id])
  ubicacion           ubicacion    @relation(fields: [ubicacionId], references: [id])
  usuario             Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([ubicacionId])
  @@index([usuarioId])
  @@map("alimentacion")
  @@schema("public")
}

model Bano {
  id            Int          @id @default(autoincrement())
  ubicacionId   Int          @map("ubicacion_id")
  fecha         DateTime     @db.Date
  tipoBanio     String?      @map("tipo_banio") @db.VarChar(20)
  regadera      String?      @db.VarChar(100)
  realizado_por String?      @db.VarChar(100)
  observacionId Int?         @map("observacion_id")
  usuarioId     Int          @map("usuario_id")
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @db.Timestamp(6)
  observacion   observacion? @relation(fields: [observacionId], references: [id])
  ubicacion     ubicacion    @relation(fields: [ubicacionId], references: [id])
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([fecha(sort: Desc)])
  @@index([ubicacionId])
  @@index([usuarioId])
  @@map("banos")
  @@schema("public")
}

model Biometria {
  id                    Int           @id @default(autoincrement())
  pileta_id             Int
  fecha                 DateTime      @default(now()) @db.Date
