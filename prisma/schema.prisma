generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalogos", "public"]
}

model Rol {
  id           Int         @id @default(autoincrement())
  nombre       String      @unique @db.VarChar(50)
  esRoot       Boolean     @default(false) @map("es_root")
  esta_activo  Boolean     @default(true)
  created_at   DateTime    @default(now()) @db.Timestamp(6)
  updated_at   DateTime    @updatedAt @db.Timestamp(6)
  rolesModulos RolModulo[]
  usuarios     Usuario[]

  @@map("roles")
  @@schema("public")
}

model Usuario {
  id                 Int                @id @default(autoincrement())
  nombre             String             @unique @db.VarChar(100)
  password           String             @db.VarChar(255)
  rolId              Int                @map("rol_id")
  esta_activo        Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  updated_at         DateTime           @updatedAt @db.Timestamp(6)
  controlLimpieza    ControlLimpieza[]
  biometrias         Biometria[]
  empleados          Empleado?
  equipos            Equipo[]
  flujo_caja         FlujoCaja[]
  inventarioAlevines InventarioAlevin[]
  medicamentos       Medicamento[]
  observacion        observacion[]
  parametrosFisicoQuimicos ParametrosFisicoQuimico[]
  controlFaunaNociva ControlFaunaNociva[]
  limpiezaInstalaciones LimpiezaInstalacion[]
  inventarioInsumos  InventarioInsumo[]
  refreshTokens      RefreshToken[]
  siembra            siembra[]
  rol                Rol                @relation(fields: [rolId], references: [id])
  ventas             Venta[]
  controlVisitas     ControlVisita[]
  bitacoraMantenimientoEquipos BitacoraMantenimientoEquipo[]

  @@index([rolId])
  @@map("usuarios")
  @@schema("public")
}

model Modulo {
  id           Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(80)
  ruta         String      @unique @db.VarChar(120)
  esta_activo  Boolean     @default(true)
  rolesModulos RolModulo[]

  @@map("modulos")
  @@schema("public")
}

model RolModulo {
  rolId    Int    @map("rol_id")
  moduloId Int    @map("modulo_id")
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  rol      Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, moduloId])
  @@map("roles_modulos")
  @@schema("public")
}

model RefreshToken {
  id               Int      @id @default(autoincrement())
  usuarioId        Int      @map("usuario_id")
  token            String   @unique @db.VarChar(255)
  fecha_expiracion DateTime @db.Timestamp(6)
  es_revocado      Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
  @@schema("public")
}

model Puesto {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  esta_activo Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  empleados   Empleado[]

  @@map("puestos")
  @@schema("public")
}

model Departamento {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  esta_activo Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  empleados   Empleado[]

  @@map("departamentos")
  @@schema("public")
}

model TipoDocumento {
  id          Int                 @id @default(autoincrement())
  nombre      String              @unique @db.VarChar(100)
  esta_activo Boolean             @default(true)
  created_at  DateTime            @default(now()) @db.Timestamp(6)
  updated_at  DateTime            @updatedAt @db.Timestamp(6)
  documentos  DocumentoEmpleado[]

  @@map("tipos_documento")
  @@schema("public")
}

model UnidadNegocio {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  esta_activo Boolean    @default(true)
  ubicacionId Int?       @map("ubicacion_id")
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)
  ubicacion   ubicacion? @relation(fields: [ubicacionId], references: [id])
  clientes    Cliente[]
  empleados   Empleado[]

  @@index([ubicacionId])
  @@map("unidades_negocio")
  @@schema("public")
}

/// Lote de reproductores activo en infraestructura física tipo `reproductores`. Varios registros por unidad; el último por `id` es el vigente.
model Reproductor {
  id                    Int             @id @default(autoincrement())
  infraestructura_fisica_id             Int             @map("infraestructura_fisica_id")
  fecha_siembra         DateTime?       @db.Date @map("fecha_siembra")
  lote_genetico         String?         @db.VarChar(120) @map("lote_genetico")
  activo                Boolean         @default(true)
  machos                Int             @default(0)
  genetica_machos       String?         @db.VarChar(60)
  familia_machos        String?         @db.VarChar(60)
  procedencia_machos    String?         @db.VarChar(100)
  hembras               Int             @default(0)
  genetica_hembras      String?         @db.VarChar(60)
  familia_hembras       String?         @db.VarChar(60)
  procedencia_hembras   String?         @db.VarChar(100)
  cantidad_total        Int             @default(0)
  ratio                 String?         @db.VarChar(20)
  talla                 Decimal?        @db.Decimal(10, 2)
  cantidad_alimento     Int             @default(0)
  observacion_id        Int?
  biometria_id          Int?
  siembra_origen_id     Int?            @map("siembra_origen_id")
  peso                  Int?
  /// Contador de desoves (eventos de cosecha) acumulados en el lote vigente.
  desovez               Int             @default(0)
  /// Ciclo reproductivo del lote: activo puede seguir desovando; agotado por cosechas repetidas.
  estado_ciclo          EstadoCicloReproductor @default(activo) @map("estado_ciclo")
  biometrias            Biometria?      @relation(fields: [biometria_id], references: [id])
  historial_peso        HistorialPeso?  @relation(fields: [peso], references: [id], onDelete: SetNull, onUpdate: Cascade)
  observacion           observacion?    @relation(fields: [observacion_id], references: [id])
  infraestructuraFisica               InfraestructuraFisica          @relation(fields: [infraestructura_fisica_id], references: [id])
  siembra_origen        siembra?        @relation("ReproductorSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)
  eventos_cosecha            EventoCosecha[]
  eficiencias_reproductivas  eficiencia_reproductiva[]

  @@index([infraestructura_fisica_id])
  @@index([activo])
  @@index([infraestructura_fisica_id, activo])
  @@index([estado_ciclo])
  @@map("reproductores")
  @@schema("public")
}

/// Evento de cosecha / desove que enlaza un lote de reproductores con la eficiencia reproductiva.
model EventoCosecha {
  id                 Int          @id @default(autoincrement())
  codigo             String       @unique @db.VarChar(24)
  reproductor_id     Int          @map("reproductor_id")
  infraestructura_fisica_id          Int          @map("infraestructura_fisica_id")
  fecha_cosecha      DateTime     @db.Date @map("fecha_cosecha")
  tipo_cosecha       TipoCosecha  @map("tipo_cosecha")
  estadio_desarrollo String?      @db.VarChar(80) @map("estadio_desarrollo")
  volumen_ml         Decimal?     @db.Decimal(12, 2) @map("volumen_ml")
  hembras_ovadas     Int          @default(0) @map("hembras_ovadas")
  observacion_id     Int?
  created_at         DateTime     @default(now()) @db.Timestamp(6)
  reproductor        Reproductor  @relation(fields: [reproductor_id], references: [id], onDelete: Restrict)
  infraestructuraFisica            InfraestructuraFisica       @relation(fields: [infraestructura_fisica_id], references: [id])
  observacion             observacion?            @relation(fields: [observacion_id], references: [id])
  eficiencia_reproductiva eficiencia_reproductiva?

  @@index([infraestructura_fisica_id])
  @@index([reproductor_id])
  @@index([fecha_cosecha(sort: Desc)])
  @@map("evento_cosecha")
  @@schema("public")
}

/// Unidad física del ciclo reproductivo: reproductores → alevinaje → engorda; traslados mediante `siembra`.
/// `metros_cubicos` debe alinearse con largo×ancho×alto (API o columna GENERATED en migración SQL).
model InfraestructuraFisica {
  id                                                                      Int                @id @default(autoincrement())
  nombre                                                                  String             @db.VarChar(100)
  largo                                                                   Decimal            @db.Decimal(10, 2)
  ancho                                                                   Decimal            @db.Decimal(10, 2)
  alto                                                                    Decimal            @db.Decimal(10, 2)
  metros_cubicos                                                          Decimal            @db.Decimal(14, 3)
  material                                                                String             @db.VarChar(80)
  estado                                                                  InfraestructuraFisicaEstado       @default(vacia)
  tipo                                                                    InfraestructuraFisicaTipo
  estadoConservacion                                                      String?            @map("estado_conservacion") @db.VarChar(100)
  tipoInfraestructuraFisicaId                                             Int?               @map("tipo_infraestructura_fisica_id")
  ubicacionId                                                             Int                @map("ubicacion_id")
  created_at                                                              DateTime           @default(now()) @db.Timestamp(6)
  updated_at                                                              DateTime           @updatedAt @db.Timestamp(6)
  alevinaje                                                               alevinaje[]
  eficiencia_reproductiva                                                 eficiencia_reproductiva[] @relation("EficienciaReproductivaInfraestructuraFisicaDestino")
  eficiencia_reproductiva_origen                                          eficiencia_reproductiva[] @relation("EficienciaReproductivaInfraestructuraFisicaOrigen")
  eventos_cosecha                                                         EventoCosecha[]
  biometrias                                                              Biometria[]
  engorda                                                                 Engorda[]
  inventario_alevines                                                     InventarioAlevin[]
  observaciones                                                           observacion[]
  tipoInfraestructuraFisica                                               TipoInfraestructuraFisica?        @relation(fields: [tipoInfraestructuraFisicaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ubicacion                                                               ubicacion          @relation(fields: [ubicacionId], references: [id])
  limpiezaInstalaciones                                                   LimpiezaInstalacion[]
  reproductores                                                           Reproductor[]
  parametrosFisicoQuimicos                                                ParametrosFisicoQuimico[]
  medicamentos                                                            Medicamento[]
  siembra_siembra_infraestructura_fisica_destinoToInfraestructuraFisica   siembra[]          @relation("siembra_infraestructura_fisica_destinoToInfraestructuraFisica")
  siembra_siembra_infraestructura_fisica_origenToInfraestructuraFisica    siembra[]          @relation("siembra_infraestructura_fisica_origenToInfraestructuraFisica")
  lista_espera                                                            ListaEspera[]

  @@unique([nombre, ubicacionId])
  @@index([estado])
  @@index([tipo])
  @@index([tipoInfraestructuraFisicaId])
  @@index([ubicacionId])
  @@map("infraestructura_fisica")
  @@schema("public")
}

/// Inventario operativo en infraestructura física tipo `engorda` (cantidad, alimento, peso).
model Engorda {
  id                Int            @id @default(autoincrement())
  infraestructura_fisica_id         Int            @map("infraestructura_fisica_id")
  cantidad_total    Int            @default(0)
  cantidad_alimento Int            @default(0)
  observacion_id    Int?
  biometria_id      Int?
  siembra_origen_id Int?           @map("siembra_origen_id")
  peso              Int?
  biometrias        Biometria?     @relation(fields: [biometria_id], references: [id])
  historial_peso    HistorialPeso? @relation(fields: [peso], references: [id], onDelete: SetNull, onUpdate: Cascade)
  observacion       observacion?   @relation(fields: [observacion_id], references: [id])
  infraestructuraFisica           InfraestructuraFisica         @relation(fields: [infraestructura_fisica_id], references: [id])
  siembra_origen    siembra?       @relation("EngordaSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)

  @@index([infraestructura_fisica_id])
  @@map("engorda")
  @@schema("public")
}

model Equipo {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  tipo           String?         @db.VarChar(80)
  marca          String?         @db.VarChar(80)
  modelo         String?         @db.VarChar(80)
  serial         String?         @db.VarChar(80)
  usuarioId      Int?            @map("usuario_id")
  estado         String?         @db.VarChar(30)
  observaciones  String?         @db.VarChar(300)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  updated_at     DateTime        @updatedAt @db.Timestamp(6)
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("equipos")
  @@schema("public")
}

model BitacoraMantenimientoEquipo {
  id                 Int      @id @default(autoincrement())
  folio              String   @unique @db.VarChar(20)
  fechaMantenimiento DateTime @map("fecha_mantenimiento") @db.Date
  usuarioId          Int?     @map("usuario_id")
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @updatedAt @db.Timestamp(6)
  usuario            Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([fechaMantenimiento(sort: Desc)])
  @@index([usuarioId])
  @@map("bitacora_mantenimiento_equipos")
  @@schema("public")
}

model Empleado {
  id              Int                  @id @default(autoincrement())
  nombre          String               @db.VarChar(100)
  apellidoPaterno String               @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno String?              @map("apellido_materno") @db.VarChar(100)
  usuarioId       Int?                 @unique @map("usuario_id")
  puestoId        Int?                 @map("puesto_id")
  departamentoId  Int?                 @map("departamento_id")
  unidadNegocioId Int?                 @map("unidad_negocio_id")
  sueldo_base     Decimal?             @db.Decimal(12, 2)
  fecha_ingreso   DateTime?            @db.Date
  fechaNacimiento DateTime?            @map("fecha_nacimiento") @db.Date
  esta_activo     Boolean              @default(true)
  created_at      DateTime             @default(now()) @db.Timestamp(6)
  updated_at      DateTime             @updatedAt @db.Timestamp(6)
  actas           ActaAdministrativa[]
  documentos      DocumentoEmpleado[]
  departamento    Departamento?        @relation(fields: [departamentoId], references: [id])
  puesto          Puesto?              @relation(fields: [puestoId], references: [id])
  unidadNegocio   UnidadNegocio?       @relation(fields: [unidadNegocioId], references: [id], onDelete: SetNull)
  usuario         Usuario?             @relation(fields: [usuarioId], references: [id])
  nominas         Nomina[]
  vacaciones      Vacacion[]
  clientes        Cliente[]

  @@index([departamentoId])
  @@index([puestoId])
  @@index([usuarioId])
  @@index([unidadNegocioId])
  @@map("empleados")
  @@schema("public")
}

model DocumentoEmpleado {
  id              Int            @id @default(autoincrement())
  empleadoId      Int            @map("empleado_id")
  tipoDocumentoId Int?           @map("tipo_documento_id")
  nombre_archivo  String         @db.VarChar(255)
  rutaArchivo     String         @map("ruta_archivo") @db.VarChar(500)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  empleado        Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipoDocumento   TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])

  @@index([empleadoId])
  @@map("documentos_empleado")
  @@schema("public")
}

model ActaAdministrativa {
  id             Int      @id @default(autoincrement())
  empleadoId     Int      @map("empleado_id")
  descripcion    String?  @db.VarChar(500)
  nombre_archivo String   @db.VarChar(255)
  rutaArchivo    String   @map("ruta_archivo") @db.VarChar(500)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  empleado       Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("actas_administrativas")
  @@schema("public")
}

model Nomina {
  id            Int      @id @default(autoincrement())
  empleadoId    Int      @map("empleado_id")
  periodo       String   @db.VarChar(20)
  sueldo_bruto  Decimal  @db.Decimal(12, 2)
  descuentos    Decimal  @default(0) @db.Decimal(12, 2)
  sueldo_neto   Decimal  @db.Decimal(12, 2)
  fechaPago     DateTime @map("fecha_pago") @db.Date
  observaciones String?  @db.VarChar(300)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([periodo])
  @@map("nomina")
  @@schema("public")
}

model Vacacion {
  id            Int      @id @default(autoincrement())
  empleadoId    Int      @map("empleado_id")
  fecha_inicio  DateTime @db.Date
  fecha_fin     DateTime @db.Date
  dias_tomados  Int
  tipo          String   @default("ordinarias") @db.VarChar(50)
  estatus       String   @default("aprobadas") @db.VarChar(30)
  observaciones String?  @db.VarChar(300)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
  empleado      Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([fecha_inicio(sort: Desc)])
  @@map("vacaciones")
  @@schema("public")
}

model Cliente {
  id                  Int            @id @default(autoincrement())
  nombre              String         @db.VarChar(150)
  rfc                 String?        @db.VarChar(20)
  empresa             String?        @db.VarChar(150)
  telefono            String?        @db.VarChar(20)
  email               String?        @db.VarChar(100)
  localidad           String?        @db.VarChar(150)
  estado              String?        @db.VarChar(100)
  unidadNegocioId     Int?           @map("unidad_negocio_id")
  ejecutivoEmpleadoId Int?           @map("ejecutivo_empleado_id")
  esta_activo         Boolean        @default(true)
  created_at          DateTime       @default(now()) @db.Timestamp(6)
  updated_at          DateTime       @updatedAt @db.Timestamp(6)
  unidadNegocio       UnidadNegocio? @relation(fields: [unidadNegocioId], references: [id], onDelete: SetNull)
  ejecutivo           Empleado?      @relation(fields: [ejecutivoEmpleadoId], references: [id], onDelete: SetNull)
  lista_espera        ListaEspera[]
  catalogoInsumos     CatalogoInsumo[]

  @@index([nombre])
  @@index([unidadNegocioId])
  @@index([ejecutivoEmpleadoId])
  @@map("clientes")
  @@schema("public")
}

model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  rfc         String?  @db.VarChar(13)
  telefono    String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  direccion   String?  @db.VarChar(255)
  esta_activo Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamp(6)

  @@index([nombre])
  @@map("proveedores")
  @@schema("public")
}

model Venta {
  id              Int          @id @default(autoincrement())
  folio           String?      @db.VarChar(50)
  fecha           DateTime     @db.Date
  cliente_nombre  String       @db.VarChar(150)
  tipoVenta       String       @map("tipo_venta") @db.VarChar(50)
  cantidad        Int
  precio_unitario Decimal      @db.Decimal(10, 2)
  montoTotal      Decimal      @map("monto_total") @db.Decimal(12, 2)
  monto_abonado   Decimal      @default(0) @db.Decimal(12, 2)
  monto_adeudo    Decimal      @default(dbgenerated("(monto_total - monto_abonado)")) @db.Decimal(12, 2)
  estadoPago      String       @default("ADEUDO") @map("estado_pago") @db.VarChar(20)
  empresa         String       @db.VarChar(255)
  vendedor_nombre String?      @db.VarChar(255)
  observacionId   Int?         @map("observacion_id")
  usuario_id      Int
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  updated_at      DateTime     @updatedAt @db.Timestamp(6)
  observacion     observacion? @relation(fields: [observacionId], references: [id])
  usuarios        Usuario      @relation(fields: [usuario_id], references: [id])
  siembras        siembra[]
  lista_espera    ListaEspera[]
  flujo_caja      FlujoCaja[]

  @@index([fecha(sort: Desc)])
  @@index([estadoPago])
  @@index([empresa])
  @@index([cliente_nombre])
  @@map("ventas")
  @@schema("public")
}

model ListaEspera {
  id                Int       @id @default(autoincrement())
  cliente_id        Int?
  cliente_nombre    String    @db.VarChar(150)
  cantidad_peces    Int?
  precio_unitario   Decimal?  @db.Decimal(10, 2)
  tipo_venta        String?   @map("tipo_venta") @db.VarChar(30)
  granja            String?   @db.VarChar(120)
  fecha_entrega     DateTime? @map("fecha_entrega") @db.Date
  lugar_entrega     String?   @map("lugar_entrega") @db.VarChar(150)
  unidad_produccion String?   @map("unidad_produccion") @db.VarChar(100)
  hora_embolsado     String?   @map("hora_embolsado") @db.VarChar(10)
  hora_entrega      String?   @map("hora_entrega") @db.VarChar(10)
  encargado_venta   String?   @map("encargado_venta") @db.VarChar(150)
  infraestructura_fisica_origen_id  Int?      @map("infraestructura_fisica_origen_id")
  venta_id          Int?      @map("venta_id")
  notas             String?   @db.VarChar(500)
  estatus           String    @default("PENDIENTE") @db.VarChar(30)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)
  clientes          Cliente?  @relation(fields: [cliente_id], references: [id])
  infraestructuraFisicaOrigen     InfraestructuraFisica?   @relation(fields: [infraestructura_fisica_origen_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  venta             Venta?    @relation(fields: [venta_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([cliente_id])
  @@index([estatus])
  @@index([infraestructura_fisica_origen_id])
  @@index([venta_id])
  @@index([fecha_entrega])
  @@map("lista_espera")
  @@schema("public")
}

model Cuenta {
  id             Int      @id @default(autoincrement())
  unidad_negocio String   @db.VarChar(100)
  nombre         String   @db.VarChar(100)
