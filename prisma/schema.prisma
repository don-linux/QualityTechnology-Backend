/// Inventario operativo en infraestructura física tipo `alevinaje` (cantidad, lote, talla).
model alevinaje {
  id                Int           @id @default(autoincrement())
  infraestructura_fisica_id         Int           @map("infraestructura_fisica_id")
  /// Lote genético heredado de eficiencia reproductiva o capturado manualmente.
  lote              String?       @db.VarChar(60)
  cantidad_total    Int           @default(0)
  biometria_id      Int?
  siembra_origen_id Int?          @map("siembra_origen_id")
  peso              Int?
  biometrias        Biometria?    @relation(fields: [biometria_id], references: [id])
  historial_peso    HistorialPeso? @relation(fields: [peso], references: [id], onDelete: SetNull, onUpdate: Cascade)
  infraestructuraFisica           InfraestructuraFisica        @relation(fields: [infraestructura_fisica_id], references: [id])
  siembra_origen    siembra?      @relation("AlevinajeSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)

  @@index([infraestructura_fisica_id])
  @@index([lote])
  @@schema("public")
}

/// Inventario operativo en infraestructura física tipo `incubacion`. Tabla única del módulo de Eficiencia
/// reproductiva: incluye los datos del desove/cosecha (tipo, hembras ovadas, estadio, fecha y
/// estanque de reproductores de origen) fusionados con los de la estancia en eficiencia reproductiva.
model eficiencia_reproductiva {
  id                 Int            @id @default(autoincrement())
  codigo             String?        @unique @db.VarChar(24)
  infraestructura_fisica_id          Int            @map("infraestructura_fisica_id")
  infraestructura_fisica_origen_id   Int?           @map("infraestructura_fisica_origen_id")
  reproductor_id     Int?
  lote               String         @db.VarChar(60)
  /// Tipos de cosecha del desove. Permite seleccionar más de una opción (huevo, larva con saco, alevín nadando).
  tipo_cosecha       TipoCosecha[]  @default([])
  estadio_desarrollo String?        @db.VarChar(80)
  hembras_ovadas     Int            @default(0)
  fecha_cosecha      DateTime?      @db.Date
  huevos_ml          Decimal?       @db.Decimal(10, 2)
  /// Volumen / contrapeso (ml o g) capturado por cada tipo de cosecha seleccionado: mapa { tipo: número }.
  /// `huevos_ml` conserva la suma total para trazabilidad y compatibilidad.
  volumen_por_tipo   Json?          @map("volumen_por_tipo")
  fecha_ingreso      DateTime?      @db.Date
  dias_en_infraestructura_fisica     Int?           @map("dias_en_infraestructura_fisica")
  fecha_egreso       DateTime?      @db.Date
  evento_cosecha_id  Int?           @unique @map("evento_cosecha_id")
  observacion_id     Int?
  biometria_id       Int?
  siembra_origen_id  Int?           @map("siembra_origen_id")
  biometrias         Biometria?     @relation(fields: [biometria_id], references: [id])
  observacion        observacion?   @relation(fields: [observacion_id], references: [id])
  infraestructuraFisica            InfraestructuraFisica         @relation("EficienciaReproductivaInfraestructuraFisicaDestino", fields: [infraestructura_fisica_id], references: [id])
  infraestructuraFisicaOrigen      InfraestructuraFisica?        @relation("EficienciaReproductivaInfraestructuraFisicaOrigen", fields: [infraestructura_fisica_origen_id], references: [id], onDelete: SetNull)
  reproductor        Reproductor?   @relation(fields: [reproductor_id], references: [id], onDelete: SetNull)
  evento_cosecha     EventoCosecha? @relation(fields: [evento_cosecha_id], references: [id], onDelete: SetNull)
  siembra_origen     siembra?       @relation("EficienciaReproductivaSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)

  @@unique([infraestructura_fisica_id, lote])
  @@index([infraestructura_fisica_id])
  @@index([infraestructura_fisica_origen_id])
  @@index([reproductor_id])
  @@index([lote])
  @@index([evento_cosecha_id])
  @@map("eficiencia_reproductiva")
  @@schema("public")
}

