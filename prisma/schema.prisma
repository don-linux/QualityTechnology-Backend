/// Comentario de auditoría. Si `pileta_id` está presente, permite listar la última observación por pileta (`ORDER BY created_at DESC`), p. ej. biometría en pileta X.
model observacion {
  id                 Int                @id @default(autoincrement())
  comentario         String
  usuario_id         Int
  pileta_id          Int?               @map("pileta_id")
  /// Contexto opcional del alta: biometria, siembra, reproductor, alevinaje, engorda, venta, etc.
  proceso            String?            @db.VarChar(80)
  /// Comentario de una biometría concreta (1:1 opcional); también se llena `pileta_id` para consultas por pileta.
  biometria_id       Int?               @unique @map("biometria_id")
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  pileta             Pileta?            @relation(fields: [pileta_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  biometria          Biometria?         @relation("ObservacionBiometria", fields: [biometria_id], references: [id], onDelete: Cascade)
  alevinaje          alevinaje[]
  incubacion         incubacion[]
  eventosCosecha     EventoCosecha[]
  alimentacion       Alimentacion[]
  banos              Bano[]
  engorda            Engorda[]
  insumos            Insumo[]
  inventarioAlevines InventarioAlevin[]
  medicamentos       Medicamento[]
  usuarios           Usuario            @relation(fields: [usuario_id], references: [id])
  parametros         Parametro[]
  plagas             Plaga[]
  recambios          Recambio[]
  recepcionInsumos   RecepcionInsumo[]
  reproductores      Reproductor[]
  ventas             Venta[]
  visitas            Visita[]

  @@index([created_at(sort: Desc)])
  @@index([usuario_id])
  @@index([pileta_id, created_at(sort: Desc)])
  @@schema("public")
}

/// Movimiento de organismos entre piletas (origen → destino) o egreso por venta (destino null + venta_id).
model siembra {
  id                                      Int           @id @default(autoincrement())
  pileta_origen                           Int?
  pileta_destino                          Int?
  cantidad                                BigInt
  mortalidad                              Int           @default(0)
  venta_id                                Int?          @map("venta_id")
  fecha                                   DateTime      @default(now()) @db.Date
  usuario_id                              Int
  created_at                              DateTime      @default(now()) @db.Timestamp(6)
  alevinajes_como_origen                  alevinaje[]           @relation("AlevinajeSiembraOrigen")
  incubaciones_como_origen                incubacion[]          @relation("IncubacionSiembraOrigen")
  engordas_como_origen                    Engorda[]         @relation("EngordaSiembraOrigen")
  reproductores_como_origen               Reproductor[]     @relation("ReproductorSiembraOrigen")
  venta                                   Venta?        @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  piletas_siembra_pileta_destinoTopiletas Pileta?       @relation("siembra_pileta_destinoTopiletas", fields: [pileta_destino], references: [id])
  piletas_siembra_pileta_origenTopiletas  Pileta?       @relation("siembra_pileta_origenTopiletas", fields: [pileta_origen], references: [id])
  usuarios                                Usuario       @relation(fields: [usuario_id], references: [id])

  @@index([fecha(sort: Desc)])
  @@index([pileta_destino])
  @@index([pileta_origen])
  @@index([venta_id])
  @@schema("public")
}

