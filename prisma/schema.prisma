// Quality Technology - Prisma schema
// Generado a partir de bd2.sql. Modelo equivalente para PostgreSQL.
// Las tablas que NO viven en `public` se mapean explícitamente con @@schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  // Include musl alongside native so Alpine-based images and glibc dev hosts
  // both get a matching query engine after `prisma generate`.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalogos", "public", "seguridad", "rrhh"]
}

// ============================================================================
// 1.5 Auth / Seguridad
// ============================================================================

model Rol {
  rolId    Int     @id @default(autoincrement()) @map("rol_id")
  nombre   String  @unique(map: "roles_nombre_uk") @db.VarChar(50)
  esRoot   Boolean @default(false) @map("es_root")

  usuarios     Usuario[]
  rolesModulos RolModulo[]

  @@map("roles")
  @@schema("public")
}

model Usuario {
  usuarioId    Int     @id @default(autoincrement()) @map("usuario_id")
  nombre       String  @unique(map: "usuarios_nombre_uk") @db.VarChar(100)
  contrasena   String  @map("contraseña") @db.VarChar(255)
  rolId        Int     @map("rol_id")
  empresaId    Int?    @map("empresa_id")
  activo       Boolean @default(true)

  rol            Rol             @relation(fields: [rolId], references: [rolId], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens  RefreshToken[]
  empleados      Empleado[]
  observaciones  Observacion[]
  instalaciones  Instalacion[]
  reproductores  Reproductor[]
  lotes          Lote[]
  piletas        Pileta[]
  engorda        Engorda[]
  equipos        Equipo[]
  alimentos      Alimento[]
  trazaAlevinaje TrazaAlevinaje[]
  trazaEngorda   TrazaEngorda[]
  trazaRepro     TrazaReproductor[]
  ventas         Cliente[]
  alimentacion   Alimentacion[]
  banos          Bano[]
  biometrias     Biometria[]
  insumos        Insumo[]
  inventarioAlevines InventarioAlevin[]
  medicamentos   Medicamento[]
  parametros     Parametro[]
  plagas         Plaga[]
  recambios      Recambio[]
  recepcionInsumos RecepcionInsumo[]
  visitas        Visita[]
  nominas        Nomina[]
  loteMovimientos LoteMovimiento[]

  @@index([rolId], map: "usuarios_rol_idx")
  @@map("usuarios")
  @@schema("public")
}

model Modulo {
  moduloId Int     @id @default(autoincrement()) @map("modulo_id")
  nombre   String  @unique(map: "modulos_nombre_uk") @db.VarChar(50)
  ruta     String  @unique(map: "modulos_ruta_uk") @db.VarChar(100)
  activo   Boolean @default(true)

  rolesModulos RolModulo[]

  @@map("modulos")
  @@schema("public")
}

model RolModulo {
  rolId    Int @map("rol_id")
  moduloId Int @map("modulo_id")

  rol    Rol    @relation(fields: [rolId], references: [rolId], onDelete: Cascade, onUpdate: Cascade)
  modulo Modulo @relation(fields: [moduloId], references: [moduloId], onDelete: Cascade, onUpdate: Cascade)

  @@id([rolId, moduloId], map: "roles_modulos_pk")
  @@map("roles_modulos")
  @@schema("public")
}

model RefreshToken {
  tokenId    Int      @id @default(autoincrement()) @map("token_id")
  usuarioId  Int      @map("usuario_id")
  token      String   @unique(map: "refresh_tokens_token_uk") @db.VarChar(255)
  expiracion DateTime @db.Timestamp(6)
  revocado   Boolean  @default(false)
  creacion   DateTime @default(now()) @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuarioId], map: "refresh_tokens_usuario_idx")
  @@map("refresh_tokens")
  @@schema("public")
}

// ============================================================================
// RRHH catalogos
// ============================================================================

model Puesto {
  puestoId Int     @id @default(autoincrement()) @map("puesto_id")
  nombre   String  @unique(map: "puestos_nombre_uk") @db.VarChar(120)
  activo   Boolean @default(true)

  empleados Empleado[]

  @@map("puestos")
  @@schema("public")
}

model Departamento {
  departamentoId Int     @id @default(autoincrement()) @map("departamento_id")
  nombre         String  @unique(map: "departamentos_nombre_uk") @db.VarChar(80)
  activo         Boolean @default(true)

  empleados Empleado[]

  @@map("departamentos")
  @@schema("public")
}

model TipoDocumento {
  tipoDocumentoId Int     @id @default(autoincrement()) @map("tipo_documento_id")
  nombre          String  @unique(map: "tipos_documento_nombre_uk") @db.VarChar(80)
  obligatorio     Boolean @default(false)
  activo          Boolean @default(true)

  documentos DocumentoEmpleado[]

  @@map("tipos_documento")
  @@schema("public")
}

model UnidadNegocio {
  unidadNegocioId Int     @id @default(autoincrement()) @map("unidad_negocio_id")
  nombre          String  @unique(map: "unidades_negocio_nombre_uk") @db.VarChar(100)
  activo          Boolean @default(true)

  empleados   Empleado[]
  clientes    Cliente[]
  proveedores Proveedor[]

  @@map("unidades_negocio")
  @@schema("public")
}

// ============================================================================
// 1.6 Observaciones
// ============================================================================

model Observacion {
  observacionId Int      @id @default(autoincrement()) @map("observacion_id")
  observacion   String?  @db.VarChar(500)
  responsable   String?  @db.VarChar(100)
  usuarioId     Int?     @map("usuario_id")
  fecha         DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  usuario       Usuario? @relation(fields: [usuarioId], references: [usuarioId], onDelete: SetNull)

  reproductores  Reproductor[]
  lotes          Lote[]
  piletas        Pileta[]
  engorda        Engorda[]
  equipos        Equipo[]
  mantenimientos Mantenimiento[]
  trazaAlevinaje TrazaAlevinaje[]
  trazaEngorda   TrazaEngorda[]
  trazaRepro     TrazaReproductor[]
  ventas         Venta[]
  alimentacion   Alimentacion[]
  banos          Bano[]
  biometrias     Biometria[]
  insumos        Insumo[]
  inventarioAlevines InventarioAlevin[]
  medicamentos   Medicamento[]
  parametros     Parametro[]
  plagas         Plaga[]
  recambios      Recambio[]
  recepcionInsumos RecepcionInsumo[]
  visitas        Visita[]
  loteMovimientos LoteMovimiento[]

  @@index([usuarioId], map: "observaciones_usuario_idx")
  @@index([fecha(sort: Desc)], map: "observaciones_fecha_idx")
  @@map("observaciones")
  @@schema("public")
}

// ============================================================================
// 1.7 Ubicaciones
// ============================================================================

model Ubicacion {
  ubicacionId Int     @id @default(autoincrement()) @map("ubicacion_id")
  nombre      String  @unique(map: "ubicaciones_nombre_uk") @db.VarChar(150)
  direccion   String? @db.VarChar(300)
  descripcion String? @db.VarChar(500)
  activo      Boolean @default(true)

  instalaciones  Instalacion[]
  reproductores  Reproductor[]
  lotes          Lote[]
  piletas        Pileta[]
  engorda        Engorda[]
  trazaAlevinaje TrazaAlevinaje[]
  cajaAhorro     CajaAhorroResumen[]
  listaEspera    ListaEspera[]
  flujoCaja      FlujoCaja[]
  alimentacion   Alimentacion[]
  banos          Bano[]
  biometrias     Biometria[]
  insumos        Insumo[]
  inventarioAlevines InventarioAlevin[]
  medicamentos   Medicamento[]
  parametros     Parametro[]
  plagas         Plaga[]
  recambios      Recambio[]
  recepcionInsumos RecepcionInsumo[]
  visitas        Visita[]

  @@index([activo], map: "ubicaciones_activo_idx")
  @@map("ubicaciones")
  @@schema("public")
}

// ============================================================================
// 2. Instalaciones
// ============================================================================

model Instalacion {
  instalacionId    Int      @id @default(autoincrement()) @map("instalacion_id")
  nombreInstalacion String  @map("nombre_instalacion") @db.VarChar(100)
  largo            Decimal  @db.Decimal(10, 2)
  ancho            Decimal  @db.Decimal(10, 2)
  altura           Decimal  @db.Decimal(10, 2)
  material         String   @db.VarChar(100)
  metrosCubicos    Decimal? @map("metros_cubicos") @db.Decimal(12, 2)
  tipoInstalacion  String   @map("tipo_instalacion") @db.VarChar(20)
  estado           String   @default("vacia") @db.VarChar(20)
  ubicacionId      Int      @map("ubicacion_id")
  usuarioId        Int      @map("usuario_id")

  ubicacion      Ubicacion @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  usuario        Usuario   @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  reproductores  Reproductor[]
  lotes          Lote[]
  piletas        Pileta[]
  engorda        Engorda[]
  trazaAlevOrig  TrazaAlevinaje[] @relation("traza_alev_inst_origen")
  trazaAlevDest  TrazaAlevinaje[] @relation("traza_alev_inst_destino")
  biometrias     Biometria[]

  @@unique([nombreInstalacion, ubicacionId], map: "instalaciones_nombre_uk")
  @@index([ubicacionId], map: "instalaciones_ubicacion_idx")
  @@index([tipoInstalacion], map: "instalaciones_tipo_idx")
  @@index([usuarioId], map: "instalaciones_usuario_idx")
  @@map("instalaciones")
  @@schema("public")
}

// ============================================================================
// 3. Reproductores
// ============================================================================

model Reproductor {
  reproductorId   Int       @id @default(autoincrement()) @map("reproductor_id")
  instalacionId   Int       @map("instalacion_id")
  machos          Int       @default(0)
  hembras         Int       @default(0)
  cantidad        Int?
  talla           Decimal?  @db.Decimal(10, 2)
  ratio           String?   @db.VarChar(10)
  linea           String?   @db.VarChar(50)
  familia         String?   @db.VarChar(20)
  fechaSiembra    DateTime? @map("fecha_siembra") @db.Date
  fechaBiometria  DateTime? @map("fecha_biometria") @db.Date
  ubicacionId     Int       @map("ubicacion_id")
  usuarioId       Int       @map("usuario_id")
  observacionId   Int?      @map("observacion_id")

  instalacion    Instalacion  @relation(fields: [instalacionId], references: [instalacionId], onDelete: Restrict, onUpdate: Cascade)
  ubicacion      Ubicacion    @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  usuario        Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  observacion    Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)
  alimentos      Alimento[]
  trazaOrigen    TrazaReproductor[] @relation("traza_repro_origen")
  trazaDestino   TrazaReproductor[] @relation("traza_repro_destino")
  biometrias     Biometria[]

  @@index([instalacionId], map: "reproductores_instalacion_idx")
  @@index([ubicacionId], map: "reproductores_ubicacion_idx")
  @@index([familia], map: "reproductores_familia_idx")
  @@map("reproductores")
  @@schema("public")
}

// ============================================================================
// 4. Lotes
// ============================================================================

model Lote {
  loteId                Int       @id @default(autoincrement()) @map("lote_id")
  instalacionId         Int       @map("instalacion_id")
  fecha                 DateTime  @db.Date
  familia               String    @db.VarChar(50)
  noLote                String    @unique(map: "lotes_no_lote_uk") @map("no_lote") @db.VarChar(50)
  huevosMl              Decimal?  @map("huevos_ml") @db.Decimal(10, 2)
  ovadas                Int       @default(0)
  alevinesInicial       Int       @map("alevines_inicial")
  mortalidad            Int       @default(0)
  mortalidadPorcentaje  Decimal?  @map("mortalidad_porcentaje") @db.Decimal(6, 2)
  ubicacionId           Int       @map("ubicacion_id")
  usuarioId             Int       @map("usuario_id")
  observacionId         Int?      @map("observacion_id")

  instalacion   Instalacion  @relation(fields: [instalacionId], references: [instalacionId], onDelete: Restrict, onUpdate: Cascade)
  ubicacion     Ubicacion    @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  usuario       Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  observacion   Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)
  piletas       Pileta[]
  engorda       Engorda[]
  trazaAlevinaje TrazaAlevinaje[]
  movimientos   LoteMovimiento[]

  @@index([instalacionId], map: "lotes_instalacion_idx")
  @@index([ubicacionId], map: "lotes_ubicacion_idx")
  @@index([fecha], map: "lotes_fecha_idx")
  @@map("lotes")
  @@schema("public")
}

// ============================================================================
// 5. Piletas
// ============================================================================

model Pileta {
  piletaId             Int       @id @default(autoincrement()) @map("pileta_id")
  instalacionId        Int       @unique(map: "piletas_instalacion_uk") @map("instalacion_id")
  loteId               Int?      @map("lote_id")
  cantidad             BigInt    @default(0)
  tallaGr              Decimal?  @map("talla_gr") @db.Decimal(14, 2)
  fechaSiembra         DateTime  @default(dbgenerated("CURRENT_DATE")) @map("fecha_siembra") @db.Date
  fechaUltimaBiometria DateTime  @default(dbgenerated("CURRENT_DATE")) @map("fecha_ultima_biometria") @db.Date
  ubicacionId          Int       @map("ubicacion_id")
  usuarioId            Int       @map("usuario_id")
  observacionId        Int?      @map("observacion_id")

  instalacion    Instalacion  @relation(fields: [instalacionId], references: [instalacionId], onDelete: Restrict, onUpdate: Cascade)
  lote           Lote?        @relation(fields: [loteId], references: [loteId], onDelete: SetNull, onUpdate: Cascade)
  ubicacion      Ubicacion    @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  usuario        Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  observacion    Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)
  alimentos      Alimento[]
  trazaOrigen    TrazaAlevinaje[] @relation("traza_alev_pileta_origen")
  trazaDestino   TrazaAlevinaje[] @relation("traza_alev_pileta_destino")

  @@index([loteId], map: "piletas_lote_idx")
  @@index([ubicacionId], map: "piletas_ubicacion_idx")
  @@index([usuarioId], map: "piletas_usuario_idx")
  @@map("piletas")
  @@schema("public")
}

// ============================================================================
// 6. Engorda
// ============================================================================

model Engorda {
  engordaId       Int       @id @default(autoincrement()) @map("engorda_id")
  instalacionId   Int       @map("instalacion_id")
  loteId          Int       @map("lote_id")
  cantidad        Int
  tallaGr         Decimal?  @map("talla_gr") @db.Decimal(10, 2)
  fechaSiembra    DateTime? @map("fecha_siembra") @db.Date
  fechaBiometria  DateTime? @map("fecha_biometria") @db.Date
  ubicacionId     Int       @map("ubicacion_id")
  usuarioId       Int       @map("usuario_id")
  observacionId   Int?      @map("observacion_id")

  instalacion   Instalacion  @relation(fields: [instalacionId], references: [instalacionId], onDelete: Restrict, onUpdate: Cascade)
  lote          Lote         @relation(fields: [loteId], references: [loteId], onDelete: Restrict, onUpdate: Cascade)
  ubicacion     Ubicacion    @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  usuario       Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  observacion   Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)
  alimentos     Alimento[]
  trazaOrigen   TrazaEngorda[] @relation("traza_eng_origen")
  trazaDestino  TrazaEngorda[] @relation("traza_eng_destino")

  @@index([instalacionId], map: "engorda_instalacion_idx")
  @@index([loteId], map: "engorda_lote_idx")
  @@index([ubicacionId], map: "engorda_ubicacion_idx")
  @@map("engorda")
  @@schema("public")
}

// ============================================================================
// 7. Equipos / 8. Mantenimientos
// ============================================================================

model Equipo {
  equipoId            Int       @id @default(autoincrement()) @map("equipo_id")
  nombre              String    @db.VarChar(150)
  marca               String?   @db.VarChar(100)
  modelo              String?   @db.VarChar(100)
  tipo                String?   @db.VarChar(100)
  fechaCompra         DateTime? @map("fecha_compra") @db.Date
  costo               Decimal?  @db.Decimal(12, 2)
  estado              String    @default("Operativo") @db.VarChar(50)
  ubicacion           String?   @db.VarChar(150)
  proximoMantenimiento DateTime? @map("proximo_mantenimiento") @db.Date
  notas               String?
  usuarioId           Int       @map("usuario_id")
  observacionId       Int?      @map("observacion_id")

  usuario        Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  observacion    Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)
  mantenimientos Mantenimiento[]

  @@index([usuarioId], map: "equipos_usuario_idx")
  @@index([estado], map: "equipos_estado_idx")
  @@map("equipos")
  @@schema("public")
}

model Mantenimiento {
  mantenimientoId      Int       @id @default(autoincrement()) @map("mantenimiento_id")
  equipoId             Int       @map("equipo_id")
  fecha                DateTime  @db.Date
  tipo                 String    @default("Preventivo") @db.VarChar(50)
  descripcion          String?
  costo                Decimal   @default(0) @db.Decimal(12, 2)
  estadoPost           String?   @map("estado_post") @db.VarChar(50)
  proximoMantenimiento DateTime? @map("proximo_mantenimiento") @db.Date
  observacionId        Int?      @map("observacion_id")

  equipo      Equipo       @relation(fields: [equipoId], references: [equipoId], onDelete: Cascade, onUpdate: Cascade)
  observacion Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)

  @@index([equipoId], map: "mantenimientos_equipo_idx")
  @@index([fecha], map: "mantenimientos_fecha_idx")
  @@map("mantenimientos")
  @@schema("public")
}

// ============================================================================
// 9. Alimentos
// ============================================================================

model Alimento {
  alimentoId     Int      @id @default(autoincrement()) @map("alimento_id")
  piletaId       Int?     @map("pileta_id")
  engordaId      Int?     @map("engorda_id")
  reproductorId  Int?     @map("reproductor_id")
  particulaMm    Decimal? @map("particula_mm") @db.Decimal(10, 2)
  alimentoDia    Decimal? @map("alimento_dia") @db.Decimal(10, 3)
  porcion        Decimal? @db.Decimal(10, 3)
  gastoAlimento  Decimal? @map("gasto_alimento") @db.Decimal(12, 2)
  usuarioId      Int      @map("usuario_id")

  pileta      Pileta?      @relation(fields: [piletaId], references: [piletaId], onDelete: Cascade, onUpdate: Cascade)
  engorda     Engorda?     @relation(fields: [engordaId], references: [engordaId], onDelete: Cascade, onUpdate: Cascade)
  reproductor Reproductor? @relation(fields: [reproductorId], references: [reproductorId], onDelete: Cascade, onUpdate: Cascade)
  usuario     Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)

  @@index([piletaId], map: "alimentos_pileta_idx")
  @@index([engordaId], map: "alimentos_engorda_idx")
  @@index([reproductorId], map: "alimentos_reproductor_idx")
  @@index([usuarioId], map: "alimentos_usuario_idx")
  @@map("alimentos")
  @@schema("public")
}

// ============================================================================
// 10. Trazabilidad - Alevinaje
// ============================================================================

model TrazaAlevinaje {
  movimientoId       Int       @id @default(autoincrement()) @map("movimiento_id")
  piletaOrigen       Int?      @map("pileta_origen")
  piletaDestino      Int?      @map("pileta_destino")
  instalacionOrigen  Int?      @map("instalacion_origen")
  instalacionDestino Int?      @map("instalacion_destino")
  loteId             Int?      @map("lote_id")
  origenExterno      String?   @map("origen_externo")
  tipoMovimiento     String    @default("TRASLADO") @map("tipo_movimiento") @db.VarChar(20)
  cantidad           BigInt
  ubicacionId        Int       @map("ubicacion_id")
  usuarioId          Int       @map("usuario_id")
  fechaMovimiento    DateTime  @default(dbgenerated("CURRENT_DATE")) @map("fecha_movimiento") @db.Date
  observacionId      Int?      @map("observacion_id")

  piletaOrig       Pileta?      @relation("traza_alev_pileta_origen", fields: [piletaOrigen], references: [piletaId], onDelete: SetNull, onUpdate: Cascade)
  piletaDest       Pileta?      @relation("traza_alev_pileta_destino", fields: [piletaDestino], references: [piletaId], onDelete: SetNull, onUpdate: Cascade)
  instalacionOrig  Instalacion? @relation("traza_alev_inst_origen", fields: [instalacionOrigen], references: [instalacionId], onDelete: SetNull, onUpdate: Cascade)
  instalacionDest  Instalacion? @relation("traza_alev_inst_destino", fields: [instalacionDestino], references: [instalacionId], onDelete: SetNull, onUpdate: Cascade)
  lote             Lote?        @relation(fields: [loteId], references: [loteId], onDelete: SetNull, onUpdate: Cascade)
  usuario          Usuario      @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict, onUpdate: Cascade)
  ubicacion        Ubicacion    @relation(fields: [ubicacionId], references: [ubicacionId], onDelete: Restrict)
  observacion      Observacion? @relation(fields: [observacionId], references: [observacionId], onDelete: SetNull)

  @@index([piletaOrigen], map: "traza_alev_pileta_origen_idx")
  @@index([piletaDestino], map: "traza_alev_pileta_destino_idx")
  @@index([instalacionOrigen], map: "traza_alev_instalacion_origen_idx")
  @@index([instalacionDestino], map: "traza_alev_instalacion_destino_idx")
  @@index([loteId], map: "traza_alev_lote_idx")
  @@index([fechaMovimiento(sort: Desc)], map: "traza_alev_fecha_idx")
  @@index([ubicacionId], map: "traza_alev_ubicacion_idx")
  @@map("trazabilidad_alevinaje")
  @@schema("public")
}

// ============================================================================
// 11. Trazabilidad - Engorda
// ============================================================================

model TrazaEngorda {
  movimientoId       Int      @id @default(autoincrement()) @map("movimiento_id")
  engordaOrigen      Int?     @map("engorda_origen")
  engordaDestino     Int?     @map("engorda_destino")
  cantidadTrasladada Int      @map("cantidad_trasladada")
  usuarioId          Int      @map("usuario_id")
  fechaMovimiento    DateTime @default(dbgenerated("CURRENT_DATE")) @map("fecha_movimiento") @db.Date
  observacionId      Int?     @map("observacion_id")

  origen      Engorda?     @relation("traza_eng_origen", fields: [engordaOrigen], references: [engordaId], onDelete: SetNull, onUpdate: Cascade)
