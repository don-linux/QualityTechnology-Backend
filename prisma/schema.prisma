/// Inventario de insumos: movimiento de insumos por unidad de negocio (granja).
/// tipo_movimiento define los campos dinamicos. Un traspaso genera dos filas
/// enlazadas por `traspaso_grupo_id` (una en la UdN de salida, otra en la de entrada).
/// NOTA: existe un indice unico PARCIAL sobre `codigo` (WHERE tipo_movimiento <> 'traspaso')
/// creado por SQL crudo en la migracion; Prisma no lo modela. No lo elimines al
/// regenerar migraciones: garantiza folios unicos para ingreso/egreso permitiendo
/// que el par de un traspaso comparta folio.
model InventarioInsumo {
  id                 Int                  @id @default(autoincrement())
  codigo             String               @db.VarChar(30)
  tipoMovimiento     TipoMovimientoInsumo @map("tipo_movimiento")
  ubicacionId        Int                  @map("ubicacion_id")
  fecha              DateTime             @db.Date
  insumoId           Int?                 @map("insumo_id")
  destino            String?              @db.VarChar(150)
  responsable        String?              @db.VarChar(100)
  ubicacionSalidaId  Int?                 @map("ubicacion_salida_id")
  ubicacionEntradaId Int?                 @map("ubicacion_entrada_id")
  traspasoSentido    TraspasoSentido?     @map("traspaso_sentido")
  traspasoGrupoId    String?              @map("traspaso_grupo_id") @db.VarChar(40)
  observacionId      Int?                 @map("observacion_id")
  usuarioId          Int?                 @map("usuario_id")
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  observacion        observacion?         @relation(fields: [observacionId], references: [id])
  ubicacion          ubicacion            @relation("InventarioInsumoUbicacion", fields: [ubicacionId], references: [id])
  ubicacionSalida    ubicacion?           @relation("InventarioInsumoUbicacionSalida", fields: [ubicacionSalidaId], references: [id])
  ubicacionEntrada   ubicacion?           @relation("InventarioInsumoUbicacionEntrada", fields: [ubicacionEntradaId], references: [id])
  catalogoInsumo     CatalogoInsumo?      @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  usuario            Usuario?             @relation(fields: [usuarioId], references: [id])

  @@index([ubicacionId])
  @@index([usuarioId])
  @@index([codigo])
  @@index([traspasoGrupoId])
  @@map("inventario_insumos")
  @@schema("public")
}

