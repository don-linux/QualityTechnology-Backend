/// Comentario de auditoría. Si `infraestructura_fisica_id` está presente, permite listar la última observación por unidad (`ORDER BY created_at DESC`), p. ej. biometría en infraestructura física X.
model observacion {
  id                 Int                @id @default(autoincrement())
  comentario         String
  usuario_id         Int
  infraestructura_fisica_id          Int?               @map("infraestructura_fisica_id")
  /// Contexto opcional del alta: biometria, siembra, reproductor, alevinaje, engorda, venta, etc.
  proceso            String?            @db.VarChar(80)
  /// Comentario de una biometría concreta (1:1 opcional); también se llena `infraestructura_fisica_id` para consultas por infraestructura física.
  biometria_id       Int?               @unique @map("biometria_id")
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  infraestructuraFisica             InfraestructuraFisica?            @relation(fields: [infraestructura_fisica_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  biometria          Biometria?         @relation("ObservacionBiometria", fields: [biometria_id], references: [id], onDelete: Cascade)
  eficiencia_reproductiva eficiencia_reproductiva[]
  eventosCosecha          EventoCosecha[]
  controlLimpieza    ControlLimpieza[]
  engorda            Engorda[]
  inventarioAlevines InventarioAlevin[]
  usuarios           Usuario            @relation(fields: [usuario_id], references: [id])
  parametrosFisicoQuimicos ParametrosFisicoQuimico[]
  limpiezaInstalaciones LimpiezaInstalacion[]
  inventarioInsumos  InventarioInsumo[]
  reproductores      Reproductor[]
  ventas             Venta[]
  controlVisitas     ControlVisita[]

  @@index([created_at(sort: Desc)])
  @@index([usuario_id])
  @@index([infraestructura_fisica_id, created_at(sort: Desc)])
  @@schema("public")
}

/// Movimiento de organismos entre unidades de infraestructura física (origen → destino) o egreso por venta (destino null + venta_id).
model siembra {
  id                                      Int           @id @default(autoincrement())
  infraestructura_fisica_origen                           Int?          @map("infraestructura_fisica_origen")
  infraestructura_fisica_destino                          Int?          @map("infraestructura_fisica_destino")
  cantidad                                BigInt
  mortalidad                              Int           @default(0)
  venta_id                                Int?          @map("venta_id")
  fecha                                   DateTime      @default(now()) @db.Date
  usuario_id                              Int
  created_at                              DateTime      @default(now()) @db.Timestamp(6)
  alevinajes_como_origen                  alevinaje[]           @relation("AlevinajeSiembraOrigen")
  eficiencias_reproductivas_como_origen   eficiencia_reproductiva[] @relation("EficienciaReproductivaSiembraOrigen")
  engordas_como_origen                    Engorda[]         @relation("EngordaSiembraOrigen")
  reproductores_como_origen               Reproductor[]     @relation("ReproductorSiembraOrigen")
  venta                                   Venta?        @relation(fields: [venta_id], references: [id], onDelete: SetNull)
  infraestructuraFisicaDestino            InfraestructuraFisica?       @relation("siembra_infraestructura_fisica_destinoToInfraestructuraFisica", fields: [infraestructura_fisica_destino], references: [id])
  infraestructuraFisicaOrigen             InfraestructuraFisica?       @relation("siembra_infraestructura_fisica_origenToInfraestructuraFisica", fields: [infraestructura_fisica_origen], references: [id])
  usuarios                                Usuario       @relation(fields: [usuario_id], references: [id])

  @@index([fecha(sort: Desc)])
  @@index([infraestructura_fisica_destino])
  @@index([infraestructura_fisica_origen])
  @@index([venta_id])
  @@schema("public")
}

model ubicacion {
