/// Inventario operativo en pileta tipo `alevinaje` (cantidad, alimento, peso).
model alevinaje {
  id                Int           @id @default(autoincrement())
  pileta_id         Int
  cantidad_total    Int           @default(0)
  cantidad_alimento Int           @default(0)
  observacion_id    Int?
  biometria_id      Int?
  siembra_origen_id Int?          @map("siembra_origen_id")
  peso              Int?
  biometrias        Biometria?    @relation(fields: [biometria_id], references: [id])
  historial_peso    HistorialPeso? @relation(fields: [peso], references: [id], onDelete: SetNull, onUpdate: Cascade)
  observacion       observacion?  @relation(fields: [observacion_id], references: [id])
  piletas           Pileta        @relation(fields: [pileta_id], references: [id])
  siembra_origen    siembra?      @relation("AlevinajeSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)

  @@index([pileta_id])
  @@schema("public")
}

/// Inventario operativo en pileta tipo `incubacion`. Tabla única del módulo de Cosecha e
/// Incubación: incluye los datos del desove/cosecha (tipo, hembras ovadas, estadio, fecha y
/// estanque de reproductores de origen) fusionados con los de la estancia en incubación.
model incubacion {
  id                 Int            @id @default(autoincrement())
  codigo             String?        @unique @db.VarChar(24)
  pileta_id          Int
  pileta_origen_id   Int?
  reproductor_id     Int?
  lote               String         @db.VarChar(60)
  /// Tipos de cosecha del desove. Permite seleccionar más de una opción (huevo, larva con saco, alevín nadando).
  tipo_cosecha       TipoCosecha[]  @default([])
  estadio_desarrollo String?        @db.VarChar(80)
  hembras_ovadas     Int            @default(0)
  fecha_cosecha      DateTime?      @db.Date
  huevos_ml          Decimal?       @db.Decimal(10, 2)
  /// Volumen / contrapeso (ml o g) capturado por cada tipo de cosecha seleccionado: mapa { tipo: número }.
  /// `huevos_ml` conserva la suma total para trazabilidad y compatibilidad.
  volumen_por_tipo   Json?          @map("volumen_por_tipo")
  fecha_ingreso      DateTime?      @db.Date
  dias_en_pileta     Int?
  fecha_egreso       DateTime?      @db.Date
  evento_cosecha_id  Int?           @unique @map("evento_cosecha_id")
  observacion_id     Int?
  biometria_id       Int?
  siembra_origen_id  Int?           @map("siembra_origen_id")
  biometrias         Biometria?     @relation(fields: [biometria_id], references: [id])
  observacion        observacion?   @relation(fields: [observacion_id], references: [id])
  piletas            Pileta         @relation("IncubacionPiletaDestino", fields: [pileta_id], references: [id])
  pileta_origen      Pileta?        @relation("IncubacionPiletaOrigen", fields: [pileta_origen_id], references: [id], onDelete: SetNull)
  reproductor        Reproductor?   @relation(fields: [reproductor_id], references: [id], onDelete: SetNull)
  evento_cosecha     EventoCosecha? @relation(fields: [evento_cosecha_id], references: [id], onDelete: SetNull)
  siembra_origen     siembra?       @relation("IncubacionSiembraOrigen", fields: [siembra_origen_id], references: [id], onDelete: SetNull)

  @@unique([pileta_id, lote])
  @@index([pileta_id])
  @@index([pileta_origen_id])
  @@index([reproductor_id])
  @@index([lote])
  @@index([evento_cosecha_id])
  @@schema("public")
}

