/// Ciclo/lote avícola (engorda, postura, etc.) independiente del inventario acuícola.
model CicloAvicola {
  id                     Int                      @id @default(autoincrement())
  id_ciclo               String                   @unique @db.VarChar(40) @map("id_ciclo")
  nombre_lote            String                   @db.VarChar(120) @map("nombre_lote")
  tipo                   TipoCicloAvicola         @default(engorda)
  especie                String                   @db.VarChar(120)
  objetivo               String?                  @db.VarChar(80)
  fecha_inicio           DateTime                 @db.Date @map("fecha_inicio")
  fecha_salida_estimada  DateTime?                @db.Date @map("fecha_salida_estimada")
  animales_iniciales     Int                      @map("animales_iniciales")
  responsable            String?                  @db.VarChar(120)
  estado                 EstadoCicloAvicola       @default(activo)
  observaciones          String?                  @db.VarChar(500)
  ubicacion_id           Int?                     @map("ubicacion_id")
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @updatedAt @db.Timestamp(6)
  ubicacion              ubicacion?               @relation(fields: [ubicacion_id], references: [id], onDelete: SetNull)
  calendario             CicloCalendarioEvento[]
  gastos                 CicloGasto[]
  ventas                 CicloVenta[]
  biometrias             CicloBiometria[]
  mortalidad             CicloMortalidad[]
  alimento_fases         CicloAlimentoFase[]
  consumo_estimado       CicloConsumoEstimado[]
  sanidad                CicloSanidad[]

  @@index([tipo])
  @@index([estado])
  @@index([ubicacion_id])
  @@map("ciclos_avicola")
  @@schema("public")
}

